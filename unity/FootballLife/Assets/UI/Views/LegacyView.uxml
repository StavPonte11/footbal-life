<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="../Styles/tokens.uss" />
    <ui:Style src="../Styles/theme-dark.uss" />
    <ui:Style src="../Styles/components.uss" />

    <ui:VisualElement class="theme-dark" style="flex-grow: 1; flex-direction: column; background-color: var(--fl-color-bg-deep);">

        <!-- APP BAR -->
        <ui:VisualElement class="app-bar" style="padding-left: 16px; padding-right: 16px;">
            <ui:Button name="btn-legacy-back" text="← Back" class="btn btn-ghost" style="font-size: 13px;" />
            <ui:Label text="👑 Career Legacy &amp; Hall of Fame" class="text-title" style="font-size: 16px; -unity-font-style: bold;" />
            <ui:Label name="label-grade-badge" text="LEGEND" class="badge badge-amber" style="font-size: 11px; -unity-font-style: bold;" />
        </ui:VisualElement>

        <!-- TABS -->
        <ui:VisualElement class="tab-bar">
            <ui:Button name="tab-retro" text="Retrospective" class="tab-button tab-button-active" />
            <ui:Button name="tab-hof" text="Hall of Fame" class="tab-button" />
            <ui:Button name="tab-retirement" text="Retirement Arc" class="tab-button" />
        </ui:VisualElement>

        <!-- MAIN SCROLL CONTENT -->
        <ui:ScrollView style="flex-grow: 1; padding-left: 16px; padding-right: 16px; padding-top: 14px; padding-bottom: 24px;">

            <!-- ── TAB 1: RETROSPECTIVE ────────────────────────────────────── -->
            <ui:VisualElement name="container-retro" style="flex-direction: column; gap: 14px;">

                <!-- SCORE & GRADE HERO CARD -->
                <ui:VisualElement class="card-elevated" style="border-color: rgba(245, 158, 11, 0.5); padding: 18px; align-items: center;">
                    <ui:Label name="label-hero-grade" text="FOOTBALL ICON" class="text-title" style="font-size: 22px; color: #F59E0B; -unity-font-style: bold; letter-spacing: 1px;" />
                    <ui:VisualElement style="flex-direction: row; gap: 10px; align-items: baseline; margin-top: 4px;">
                        <ui:Label text="Career Score:" class="text-caption" style="font-size: 13px;" />
                        <ui:Label name="label-hero-score" text="745 pts" style="font-size: 18px; color: #FFFFFF; -unity-font-style: bold;" />
                    </ui:VisualElement>
                    <ui:Label name="label-hof-status" text="⭐ Hall of Fame Inductee" class="badge badge-green" style="margin-top: 8px; font-size: 11px;" />
                </ui:VisualElement>

                <!-- LIFETIME METRICS GRID -->
                <ui:Label text="LIFETIME ACHIEVEMENTS" class="text-caption" style="font-size: 11px; -unity-font-style: bold; color: var(--fl-color-text-muted);" />
                
                <ui:VisualElement style="flex-direction: row; gap: 10px; flex-wrap: wrap;">
                    <ui:VisualElement class="card" style="flex: 1; min-width: 140px; padding: 12px; align-items: center;">
                        <ui:Label text="Appearances" class="text-caption" />
                        <ui:Label name="stat-appearances" text="420" class="text-title" style="font-size: 18px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card" style="flex: 1; min-width: 140px; padding: 12px; align-items: center;">
                        <ui:Label text="Goals Scored" class="text-caption" />
                        <ui:Label name="stat-goals" text="165" class="text-title" style="font-size: 18px; color: #10B981;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card" style="flex: 1; min-width: 140px; padding: 12px; align-items: center;">
                        <ui:Label text="Assists" class="text-caption" />
                        <ui:Label name="stat-assists" text="84" class="text-title" style="font-size: 18px; color: #38BDF8;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card" style="flex: 1; min-width: 140px; padding: 12px; align-items: center;">
                        <ui:Label text="Major Trophies" class="text-caption" />
                        <ui:Label name="stat-trophies" text="6" class="text-title" style="font-size: 18px; color: #F59E0B;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card" style="flex: 1; min-width: 140px; padding: 12px; align-items: center;">
                        <ui:Label text="International Caps" class="text-caption" />
                        <ui:Label name="stat-caps" text="48" class="text-title" style="font-size: 18px;" />
                    </ui:VisualElement>
                    <ui:VisualElement class="card" style="flex: 1; min-width: 140px; padding: 12px; align-items: center;">
                        <ui:Label text="Total Earnings" class="text-caption" />
                        <ui:Label name="stat-earnings" text="£14,500,000" class="text-title" style="font-size: 16px; color: #FBBF24;" />
                    </ui:VisualElement>
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- ── TAB 2: HALL OF FAME PLAQUE ──────────────────────────────── -->
            <ui:VisualElement name="container-hof" style="display: none; flex-direction: column; gap: 14px;">
                <ui:VisualElement class="card-elevated" style="border-color: #D97706; border-width: 2px; padding: 22px; background-color: rgba(15, 23, 42, 0.95);">
                    <ui:VisualElement style="align-items: center; margin-bottom: 12px;">
                        <ui:Label text="🏛️" style="font-size: 28px;" />
                        <ui:Label text="HALL OF FAME COMMEMORATION" class="text-title" style="font-size: 15px; color: #F59E0B; -unity-font-style: bold; letter-spacing: 1px; margin-top: 4px;" />
                    </ui:VisualElement>
                    <ui:Label name="label-plaque-text" text="Plaque citation commemorating career greatness..." style="color: #E2E8F0; font-size: 13px; line-height: 18px; white-space: normal; -unity-font-style: italic;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ── TAB 3: RETIREMENT ARC ───────────────────────────────────── -->
            <ui:VisualElement name="container-retirement" style="display: none; flex-direction: column; gap: 14px;">
                <ui:VisualElement class="card-elevated" style="padding: 16px;">
                    <ui:Label text="🚪 Career Retirement" class="text-title" style="font-size: 16px; -unity-font-style: bold; margin-bottom: 6px;" />
                    <ui:Label name="label-retirement-status-desc" text="Players can voluntarily announce retirement from age 32+, or conclude career upon contract expiration." class="text-caption" style="font-size: 12px; margin-bottom: 12px;" />

                    <ui:VisualElement name="section-active-retirement-options">
                        <ui:Label text="Choose Retirement Reason:" class="text-caption" style="margin-bottom: 4px;" />
                        <ui:VisualElement style="flex-direction: row; gap: 8px; margin-bottom: 12px; flex-wrap: wrap;">
                            <ui:Button name="btn-reason-peak" text="Voluntary (At Peak)" class="btn btn-secondary" style="font-size: 11px; height: 32px;" />
                            <ui:Button name="btn-reason-decline" text="Age &amp; Physical Decline" class="btn btn-secondary" style="font-size: 11px; height: 32px;" />
                            <ui:Button name="btn-reason-trophies" text="Cabinet Complete" class="btn btn-secondary" style="font-size: 11px; height: 32px;" />
                        </ui:VisualElement>

                        <ui:Label text="Choose Post-Playing Chapter:" class="text-caption" style="margin-bottom: 4px;" />
                        <ui:VisualElement style="flex-direction: row; gap: 8px; margin-bottom: 16px; flex-wrap: wrap;">
                            <ui:Button name="btn-role-manager" text="Senior Manager" class="btn btn-secondary" style="font-size: 11px; height: 32px;" />
                            <ui:Button name="btn-role-coach" text="Academy Coach" class="btn btn-secondary" style="font-size: 11px; height: 32px;" />
                            <ui:Button name="btn-role-pundit" text="TV Studio Pundit" class="btn btn-secondary" style="font-size: 11px; height: 32px;" />
                            <ui:Button name="btn-role-ambassador" text="Club Ambassador" class="btn btn-secondary" style="font-size: 11px; height: 32px;" />
                        </ui:VisualElement>

                        <ui:Button name="btn-confirm-retirement" text="Hang Up Boots &amp; Announce Retirement" class="btn btn-primary" style="height: 48px; font-size: 13px; -unity-font-style: bold; background-color: #DC2626;" />
                    </ui:VisualElement>

                    <ui:VisualElement name="section-already-retired" style="display: none;">
                        <ui:Label name="label-already-retired-statement" text="Player is officially retired." class="text-caption" style="font-size: 13px; color: #F59E0B; white-space: normal;" />
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>

        </ui:ScrollView>

    </ui:VisualElement>
</ui:UXML>
