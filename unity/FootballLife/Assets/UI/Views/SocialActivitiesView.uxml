<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/Styles/Common.uss" />

    <ui:VisualElement name="social-root" class="screen-container" style="background-color: rgba(6, 10, 18, 0.94); justify-content: flex-start; padding: 20px;">
        <!-- Header -->
        <ui:VisualElement name="header-bar" style="flex-direction: row; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 14px;">
            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <ui:Label text="🌆" style="font-size: 26px; margin-right: 10px;" />
                <ui:VisualElement>
                    <ui:Label text="CITY OUTINGS &amp; NIGHTLIFE" class="title-medium" style="font-size: 18px; -unity-font-style: bold; color: #f8fafc;" />
                    <ui:Label text="Spend leisure time to boost morale, bond with teammates, or build fame." style="font-size: 11px; color: #94a3b8;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Wallet & Energy Chips -->
            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <ui:VisualElement class="card-elevated" style="flex-direction: row; align-items: center; padding: 6px 12px; margin-right: 8px; border-radius: 8px; background-color: rgba(15, 23, 42, 0.8);">
                    <ui:Label text="⚡" style="font-size: 14px; margin-right: 4px;" />
                    <ui:Label name="lbl-social-energy" text="85% Energy" style="font-size: 12px; -unity-font-style: bold; color: #34d399;" />
                </ui:VisualElement>

                <ui:VisualElement class="card-elevated" style="flex-direction: row; align-items: center; padding: 6px 12px; margin-right: 12px; border-radius: 8px; background-color: rgba(15, 23, 42, 0.8);">
                    <ui:Label text="💰" style="font-size: 14px; margin-right: 4px;" />
                    <ui:Label name="lbl-social-balance" text="£45,000" style="font-size: 12px; -unity-font-style: bold; color: #38bdf8;" />
                </ui:VisualElement>

                <ui:Button name="btn-social-back" text="✕ CLOSE" class="btn-secondary" style="height: 32px; padding: 0 14px; font-size: 11px; -unity-font-style: bold;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Category Tabs -->
        <ui:VisualElement name="tabs-categories" style="flex-direction: row; margin-bottom: 14px; width: 100%;">
            <ui:Button name="tab-cat-all" text="ALL OUTINGS" class="tab-button tab-active" style="flex: 1; height: 32px; font-size: 10px; -unity-font-style: bold;" />
            <ui:Button name="tab-cat-casual" text="☕ CASUAL" class="tab-button" style="flex: 1; height: 32px; font-size: 10px; margin-left: 4px;" />
            <ui:Button name="tab-cat-teambonding" text="🎳 TEAM BONDING" class="tab-button" style="flex: 1; height: 32px; font-size: 10px; margin-left: 4px;" />
            <ui:Button name="tab-cat-nightlife" text="🍸 NIGHTLIFE" class="tab-button" style="flex: 1; height: 32px; font-size: 10px; margin-left: 4px;" />
            <ui:Button name="tab-cat-glamour" text="✨ GLAMOUR" class="tab-button" style="flex: 1; height: 32px; font-size: 10px; margin-left: 4px;" />
            <ui:Button name="tab-cat-charity" text="🎗️ CHARITY" class="tab-button" style="flex: 1; height: 32px; font-size: 10px; margin-left: 4px;" />
        </ui:VisualElement>

        <!-- Toast Feedback Banner -->
        <ui:Label name="lbl-social-toast" text="" style="display: none; width: 100%; padding: 8px 14px; margin-bottom: 10px; border-radius: 8px; font-size: 12px; -unity-font-style: bold; text-align: center;" />

        <!-- Activities Grid Container -->
        <ui:ScrollView name="scroll-activities" style="flex: 1; width: 100%;">
            <ui:VisualElement name="container-activities-grid" style="flex-direction: row; flex-wrap: wrap; justify-content: space-between; width: 100%;" />
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
