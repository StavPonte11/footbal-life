<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="../Styles/tokens.uss" />
    <ui:Style src="../Styles/theme-dark.uss" />
    <ui:Style src="../Styles/components.uss" />

    <!-- Fullscreen Finances Dashboard Screen -->
    <ui:VisualElement name="finances-root" class="screen-container theme-dark" style="flex-grow: 1; padding: 16px; background-color: #0A0F1D;">

        <!-- Top Navigation Bar -->
        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 16px;">
            <ui:Button name="btn-finances-back" text="← Return" class="btn btn-secondary" style="height: 38px; padding: 0 16px; border-radius: 8px;" />
            <ui:VisualElement style="align-items: center;">
                <ui:Label text="PERSONAL FINANCES &amp; WEALTH" class="text-title" style="font-size: 18px; font-weight: bold; color: #F8FAFC; letter-spacing: 1px;" />
                <ui:Label text="CASH FLOW &amp; ASSET MANAGEMENT" class="text-caption" style="color: #64748B; font-size: 10px;" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; align-items: center; background-color: rgba(30, 41, 59, 0.6); padding: 6px 14px; border-radius: 20px; border-width: 1px; border-color: rgba(0, 229, 255, 0.25);">
                <ui:Label text="💰 " style="font-size: 14px;" />
                <ui:Label name="label-header-balance" text="£45,000" style="color: #00E5FF; font-weight: bold; font-size: 14px;" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:ScrollView style="flex-grow: 1;">
            
            <!-- Summary Metrics Row -->
            <ui:VisualElement style="flex-direction: row; gap: 12px; margin-bottom: 16px; flex-wrap: wrap;">
                
                <!-- Metric: Bank Balance -->
                <ui:VisualElement class="card-elevated" style="flex: 1; min-width: 140px; padding: 14px; border-radius: 12px; background-color: rgba(15, 23, 42, 0.9); border-left-width: 3px; border-left-color: #00E5FF;">
                    <ui:Label text="LIQUID BANK BALANCE" class="text-caption" style="color: #64748B; font-size: 10px; font-weight: bold; margin-bottom: 4px;" />
                    <ui:Label name="metric-bank-balance" text="£45,000" style="color: #F8FAFC; font-size: 20px; font-weight: bold; margin-bottom: 2px;" />
                    <ui:Label text="Ready for investments &amp; luxury" class="text-caption" style="color: #94A3B8; font-size: 10px;" />
                </ui:VisualElement>

                <!-- Metric: Net Cash Flow -->
                <ui:VisualElement class="card-elevated" style="flex: 1; min-width: 140px; padding: 14px; border-radius: 12px; background-color: rgba(15, 23, 42, 0.9); border-left-width: 3px; border-left-color: #10B981;">
                    <ui:Label text="WEEKLY NET CASH FLOW" class="text-caption" style="color: #64748B; font-size: 10px; font-weight: bold; margin-bottom: 4px;" />
                    <ui:Label name="metric-cash-flow" text="+£3,470 / wk" style="color: #34D399; font-size: 20px; font-weight: bold; margin-bottom: 2px;" />
                    <ui:Label name="metric-cash-flow-sub" text="Healthy weekly surplus" class="text-caption" style="color: #10B981; font-size: 10px;" />
                </ui:VisualElement>

                <!-- Metric: Net Worth -->
                <ui:VisualElement class="card-elevated" style="flex: 1; min-width: 140px; padding: 14px; border-radius: 12px; background-color: rgba(15, 23, 42, 0.9); border-left-width: 3px; border-left-color: #F59E0B;">
                    <ui:Label text="ESTIMATED NET WORTH" class="text-caption" style="color: #64748B; font-size: 10px; font-weight: bold; margin-bottom: 4px;" />
                    <ui:Label name="metric-net-worth" text="£145,000" style="color: #FBBF24; font-size: 20px; font-weight: bold; margin-bottom: 2px;" />
                    <ui:Label text="Capital + Property + Assets" class="text-caption" style="color: #94A3B8; font-size: 10px;" />
                </ui:VisualElement>

                <!-- Metric: Prestige Rating -->
                <ui:VisualElement class="card-elevated" style="flex: 1; min-width: 140px; padding: 14px; border-radius: 12px; background-color: rgba(15, 23, 42, 0.9); border-left-width: 3px; border-left-color: #8B5CF6;">
                    <ui:Label text="LIFESTYLE PRESTIGE" class="text-caption" style="color: #64748B; font-size: 10px; font-weight: bold; margin-bottom: 4px;" />
                    <ui:Label name="metric-prestige" text="⭐ 80 / 100" style="color: #A78BFA; font-size: 20px; font-weight: bold; margin-bottom: 2px;" />
                    <ui:Label text="Social status &amp; fame" class="text-caption" style="color: #94A3B8; font-size: 10px;" />
                </ui:VisualElement>

            </ui:VisualElement>

            <!-- Main Content: Two Columns -->
            <ui:VisualElement style="flex-direction: row; gap: 14px; flex-wrap: wrap;">

                <!-- LEFT COLUMN: Income & Expenses Breakdown -->
                <ui:VisualElement style="flex: 1; min-width: 320px; gap: 14px;">

                    <!-- Weekly Income Breakdown Card -->
                    <ui:VisualElement class="card-elevated" style="padding: 16px; border-radius: 14px; background-color: rgba(15, 23, 42, 0.9);">
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom-width: 1px; border-bottom-color: rgba(255,255,255,0.08); padding-bottom: 8px;">
                            <ui:Label text="📈 WEEKLY INCOME BREAKDOWN" class="text-title" style="font-size: 14px; font-weight: bold; color: #34D399;" />
                            <ui:Label name="label-total-income" text="+£6,500/wk" style="color: #34D399; font-weight: bold; font-size: 14px;" />
                        </ui:VisualElement>

                        <ui:VisualElement style="gap: 8px;">
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                                <ui:Label text="Contract Base Salary" style="color: #CBD5E1; font-size: 12px;" />
                                <ui:Label name="val-income-salary" text="£5,000" style="color: #F8FAFC; font-weight: bold; font-size: 12px;" />
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                                <ui:Label text="Estimated Match Bonuses" style="color: #CBD5E1; font-size: 12px;" />
                                <ui:Label name="val-income-bonuses" text="£1,000" style="color: #F8FAFC; font-weight: bold; font-size: 12px;" />
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                                <ui:Label text="Commercial &amp; Sponsorships" style="color: #CBD5E1; font-size: 12px;" />
                                <ui:Label name="val-income-sponsorship" text="£500" style="color: #F8FAFC; font-weight: bold; font-size: 12px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Weekly Expenses Breakdown Card -->
                    <ui:VisualElement class="card-elevated" style="padding: 16px; border-radius: 14px; background-color: rgba(15, 23, 42, 0.9);">
                        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 12px; border-bottom-width: 1px; border-bottom-color: rgba(255,255,255,0.08); padding-bottom: 8px;">
                            <ui:Label text="📉 WEEKLY EXPENSES BREAKDOWN" class="text-title" style="font-size: 14px; font-weight: bold; color: #F87171;" />
                            <ui:Label name="label-total-expenses" text="-£2,805/wk" style="color: #F87171; font-weight: bold; font-size: 14px;" />
                        </ui:VisualElement>

                        <ui:VisualElement style="gap: 8px;">
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                                <ui:Label text="Living Standard Tier" style="color: #CBD5E1; font-size: 12px;" />
                                <ui:Label name="val-expense-living" text="£500" style="color: #F8FAFC; font-weight: bold; font-size: 12px;" />
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                                <ui:Label text="Residence Property Upkeep" style="color: #CBD5E1; font-size: 12px;" />
                                <ui:Label name="val-expense-apartment" text="£500" style="color: #F8FAFC; font-weight: bold; font-size: 12px;" />
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                                <ui:Label text="Lifestyle Items Maintenance" style="color: #CBD5E1; font-size: 12px;" />
                                <ui:Label name="val-expense-items" text="£155" style="color: #F8FAFC; font-weight: bold; font-size: 12px;" />
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                                <ui:Label text="Estimated Tax Withholding (35%)" style="color: #CBD5E1; font-size: 12px;" />
                                <ui:Label name="val-expense-tax" text="£1,400" style="color: #F8FAFC; font-weight: bold; font-size: 12px;" />
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; justify-content: space-between;">
                                <ui:Label text="Agent Commission (5%)" style="color: #CBD5E1; font-size: 12px;" />
                                <ui:Label name="val-expense-agent" text="£250" style="color: #F8FAFC; font-weight: bold; font-size: 12px;" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- RIGHT COLUMN: Lifestyle Living Tier & Transactions -->
                <ui:VisualElement style="flex: 1; min-width: 320px; gap: 14px;">

                    <!-- Lifestyle Living Standard Selector Card -->
                    <ui:VisualElement class="card-elevated" style="padding: 16px; border-radius: 14px; background-color: rgba(15, 23, 42, 0.9);">
                        <ui:Label text="👑 LIFESTYLE LIVING STANDARD" class="text-title" style="font-size: 14px; font-weight: bold; color: #F8FAFC; margin-bottom: 4px;" />
                        <ui:Label text="Sets baseline dining, transport &amp; daily leisure cost." class="text-caption" style="color: #94A3B8; font-size: 11px; margin-bottom: 12px;" />

                        <ui:VisualElement name="container-tier-buttons" style="gap: 6px;">
                            <ui:Button name="btn-tier-modest" text="Modest — £150 / wk" class="btn btn-secondary" style="height: 36px; font-size: 11px;" />
                            <ui:Button name="btn-tier-comfortable" text="Comfortable — £500 / wk" class="btn btn-secondary" style="height: 36px; font-size: 11px;" />
                            <ui:Button name="btn-tier-luxurious" text="Luxurious — £2,000 / wk" class="btn btn-secondary" style="height: 36px; font-size: 11px;" />
                            <ui:Button name="btn-tier-extravagant" text="Extravagant — £8,000 / wk" class="btn btn-secondary" style="height: 36px; font-size: 11px;" />
                            <ui:Button name="btn-tier-superstar" text="Superstar — £25,000 / wk" class="btn btn-secondary" style="height: 36px; font-size: 11px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- Transaction Ledger Card -->
                    <ui:VisualElement class="card-elevated" style="padding: 16px; border-radius: 14px; background-color: rgba(15, 23, 42, 0.9); flex-grow: 1;">
                        <ui:Label text="📜 RECENT TRANSACTIONS LEDGER" class="text-title" style="font-size: 14px; font-weight: bold; color: #F8FAFC; margin-bottom: 10px;" />

                        <ui:ScrollView name="scroll-transactions" style="max-height: 220px; gap: 6px;">
                            <!-- Dynamically generated rows -->
                        </ui:ScrollView>
                    </ui:VisualElement>

                </ui:VisualElement>

            </ui:VisualElement>

        </ui:ScrollView>

    </ui:VisualElement>
</ui:UXML>
