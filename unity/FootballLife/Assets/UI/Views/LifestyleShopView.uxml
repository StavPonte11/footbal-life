<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="../Styles/tokens.uss" />
    <ui:Style src="../Styles/theme-dark.uss" />
    <ui:Style src="../Styles/components.uss" />

    <!-- Fullscreen Lifestyle Shop Boutique -->
    <ui:VisualElement name="shop-root" class="screen-container theme-dark" style="flex-grow: 1; padding: 16px; background-color: #0A0F1D;">

        <!-- Top Navigation Bar -->
        <ui:VisualElement style="flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 14px;">
            <ui:Button name="btn-shop-back" text="← Return" class="btn btn-secondary" style="height: 38px; padding: 0 16px; border-radius: 8px;" />
            
            <ui:VisualElement style="align-items: center;">
                <ui:Label text="LIFESTYLE LUXURY BOUTIQUE" class="text-title" style="font-size: 18px; font-weight: bold; color: #F8FAFC; letter-spacing: 1px;" />
                <ui:Label text="VEHICLES • FASHION • GADGETS • ATHLETE WELLNESS" class="text-caption" style="color: #64748B; font-size: 10px;" />
            </ui:VisualElement>

            <ui:VisualElement style="flex-direction: row; gap: 8px; align-items: center;">
                <ui:VisualElement style="flex-direction: row; align-items: center; background-color: rgba(30, 41, 59, 0.6); padding: 6px 12px; border-radius: 20px; border-width: 1px; border-color: rgba(0, 229, 255, 0.25);">
                    <ui:Label text="💰 " style="font-size: 13px;" />
                    <ui:Label name="label-shop-balance" text="£45,000" style="color: #00E5FF; font-weight: bold; font-size: 13px;" />
                </ui:VisualElement>
                <ui:VisualElement style="flex-direction: row; align-items: center; background-color: rgba(30, 41, 59, 0.6); padding: 6px 12px; border-radius: 20px; border-width: 1px; border-color: rgba(245, 158, 11, 0.25);">
                    <ui:Label text="⭐ " style="font-size: 13px;" />
                    <ui:Label name="label-shop-prestige" text="80 Pts" style="color: #FBBF24; font-weight: bold; font-size: 13px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Category Tabs Filter Bar -->
        <ui:VisualElement style="flex-direction: row; gap: 8px; margin-bottom: 14px; justify-content: center;">
            <ui:Button name="tab-cat-all" text="⭐ All Items" class="btn btn-primary" style="height: 34px; padding: 0 14px; font-size: 12px; border-radius: 8px;" />
            <ui:Button name="tab-cat-vehicles" text="🚗 Vehicles" class="btn btn-secondary" style="height: 34px; padding: 0 14px; font-size: 12px; border-radius: 8px;" />
            <ui:Button name="tab-cat-fashion" text="⌚ Fashion" class="btn btn-secondary" style="height: 34px; padding: 0 14px; font-size: 12px; border-radius: 8px;" />
            <ui:Button name="tab-cat-tech" text="🖥️ Tech &amp; Home" class="btn btn-secondary" style="height: 34px; padding: 0 14px; font-size: 12px; border-radius: 8px;" />
            <ui:Button name="tab-cat-wellness" text="🧘 Wellness" class="btn btn-secondary" style="height: 34px; padding: 0 14px; font-size: 12px; border-radius: 8px;" />
        </ui:VisualElement>

        <!-- Catalog Items Scroll Area -->
        <ui:ScrollView name="scroll-shop-items" style="flex-grow: 1;">
            <ui:VisualElement name="container-shop-items" style="flex-direction: row; flex-wrap: wrap; gap: 12px; justify-content: space-between;">
                <!-- Dynamically generated item cards -->
            </ui:VisualElement>
        </ui:ScrollView>

        <!-- Toast Feedback Notification (hidden by default) -->
        <ui:VisualElement name="panel-shop-toast" style="display: none; position: absolute; bottom: 20px; left: 50%; translate: -50% 0; background-color: rgba(16, 185, 129, 0.95); padding: 12px 24px; border-radius: 24px; border-width: 1px; border-color: #34D399;">
            <ui:Label name="label-shop-toast-text" text="Item purchased successfully!" style="color: #FFFFFF; font-weight: bold; font-size: 13px;" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
