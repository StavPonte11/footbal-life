.theme-dark {
    background-color: var(--fl-color-bg-deep);
    color: var(--fl-color-text-primary);
    width: 100%;
    height: 100%;
    font-size: 14px;
}

.theme-dark Label {
    color: var(--fl-color-text-primary);
}

.text-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--fl-color-text-primary);
    letter-spacing: 0.5px;
}

.text-subtitle {
    font-size: 16px;
    color: var(--fl-color-text-secondary);
    margin-top: var(--fl-spacing-xs);
}

.text-caption {
    font-size: 12px;
    color: var(--fl-color-text-muted);
}

.text-accent {
    color: var(--fl-color-text-accent);
    -unity-font-style: bold;
}

.text-gold {
    color: var(--fl-color-text-gold);
    -unity-font-style: bold;
}
