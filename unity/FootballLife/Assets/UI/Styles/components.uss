/* =========================================================================
   BUTTONS
   ========================================================================= */
.btn {
    padding-left: var(--fl-spacing-md);
    padding-right: var(--fl-spacing-md);
    padding-top: var(--fl-spacing-sm);
    padding-bottom: var(--fl-spacing-sm);
    border-radius: var(--fl-radius-md);
    border-width: 1px;
    border-color: transparent;
    font-size: 14px;
    -unity-font-style: bold;
    cursor: link;
    transition-property: background-color, scale;
    transition-duration: 0.15s;
    align-items: center;
    justify-content: center;
}

.btn:hover {
    scale: 1.02;
}

.btn:active {
    scale: 0.98;
}

.btn-primary {
    background-color: var(--fl-color-primary);
    color: #FFFFFF;
}

.btn-primary:hover {
    background-color: var(--fl-color-primary-hover);
}

.btn-primary:active {
    background-color: var(--fl-color-primary-active);
}

.btn-gold {
    background-color: var(--fl-color-gold);
    color: #0F172A;
}

.btn-gold:hover {
    background-color: var(--fl-color-gold-hover);
}

.btn-secondary {
    background-color: var(--fl-color-surface-elevated);
    border-color: var(--fl-color-border);
    color: var(--fl-color-text-primary);
}

.btn-secondary:hover {
    background-color: var(--fl-color-surface-subtle);
}

.btn-danger {
    background-color: var(--fl-color-danger);
    color: #FFFFFF;
}

.btn-danger:hover {
    background-color: var(--fl-color-danger-hover);
}

.btn-ghost {
    background-color: transparent;
    border-color: transparent;
    color: var(--fl-color-text-secondary);
}

.btn-ghost:hover {
    color: var(--fl-color-text-primary);
    background-color: var(--fl-color-surface-subtle);
}

/* =========================================================================
   CARDS & CONTAINERS
   ========================================================================= */
.card {
    background-color: var(--fl-color-surface);
    border-radius: var(--fl-radius-lg);
    border-width: 1px;
    border-color: var(--fl-color-border);
    padding: var(--fl-spacing-md);
    margin-bottom: var(--fl-spacing-sm);
}

.card-elevated {
    background-color: var(--fl-color-surface-elevated);
    border-radius: var(--fl-radius-lg);
    border-width: 1px;
    border-color: var(--fl-color-border);
    padding: var(--fl-spacing-lg);
    margin-bottom: var(--fl-spacing-md);
}

.card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: var(--fl-color-border);
    padding-bottom: var(--fl-spacing-sm);
    margin-bottom: var(--fl-spacing-sm);
}

/* =========================================================================
   STAT METERS (PROGRESS BARS)
   ========================================================================= */
.stat-meter-container {
    margin-top: var(--fl-spacing-xs);
    margin-bottom: var(--fl-spacing-xs);
}

.stat-meter-header {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 2px;
}

.stat-meter-track {
    height: 8px;
    background-color: var(--fl-color-bg-deep);
    border-radius: var(--fl-radius-full);
    overflow: hidden;
    width: 100%;
}

.stat-meter-fill {
    height: 100%;
    border-radius: var(--fl-radius-full);
    background-color: var(--fl-color-primary);
    transition-property: width;
    transition-duration: 0.3s;
}

.stat-meter-fill-energy {
    background-color: #38BDF8;
}

.stat-meter-fill-form {
    background-color: #34D399;
}

.stat-meter-fill-morale {
    background-color: #FBBF24;
}

/* =========================================================================
   BADGES
   ========================================================================= */
.badge {
    padding-left: var(--fl-spacing-sm);
    padding-right: var(--fl-spacing-sm);
    padding-top: 2px;
    padding-bottom: 2px;
    border-radius: var(--fl-radius-full);
    font-size: 11px;
    -unity-font-style: bold;
    align-self: flex-start;
}

.badge-green {
    background-color: rgba(16, 185, 129, 0.2);
    color: #34D399;
    border-width: 1px;
    border-color: #10B981;
}

.badge-gold {
    background-color: rgba(245, 158, 11, 0.2);
    color: #FBBF24;
    border-width: 1px;
    border-color: #F59E0B;
}

.badge-slate {
    background-color: var(--fl-color-surface-subtle);
    color: var(--fl-color-text-secondary);
    border-width: 1px;
    border-color: var(--fl-color-border);
}

/* =========================================================================
   APP BAR & NAVIGATION
   ========================================================================= */
.app-bar {
    height: 56px;
    background-color: var(--fl-color-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--fl-color-border);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: var(--fl-spacing-md);
    padding-right: var(--fl-spacing-md);
}

.bottom-nav {
    height: 64px;
    background-color: var(--fl-color-surface);
    border-top-width: 1px;
    border-top-color: var(--fl-color-border);
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    padding-left: var(--fl-spacing-sm);
    padding-right: var(--fl-spacing-sm);
}

/* =========================================================================
   TAB BAR & STAT ROWS
   ========================================================================= */
.tab-bar {
    flex-direction: row;
    background-color: var(--fl-color-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--fl-color-border);
    padding-left: var(--fl-spacing-md);
    padding-right: var(--fl-spacing-md);
    padding-top: 6px;
    padding-bottom: 6px;
    gap: 8px;
}

.tab-button {
    flex-grow: 1;
    height: 38px;
    background-color: var(--fl-color-surface-elevated);
    border-radius: var(--fl-radius-md);
    border-width: 1px;
    border-color: var(--fl-color-border);
    color: var(--fl-color-text-secondary);
    font-size: 13px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
    cursor: link;
}

.tab-button:hover {
    background-color: var(--fl-color-surface-subtle);
    color: var(--fl-color-text-primary);
}

.tab-button-active {
    background-color: var(--fl-color-primary);
    border-color: var(--fl-color-primary);
    color: #FFFFFF;
}

.tab-button-active:hover {
    background-color: var(--fl-color-primary-hover);
    color: #FFFFFF;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 5px;
    padding-bottom: 5px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(51, 65, 85, 0.4);
}

/* =========================================================================
   ACCESSIBILITY: MINIMUM TOUCH TARGETS (#P7-603)
   All interactive elements must meet 44×44px minimum (Apple HIG / WCAG 2.5.5)
   ========================================================================= */
.btn {
    min-height: 44px;
    min-width: 44px;
}

.tab-button {
    min-height: 44px;
}

.bottom-nav Button {
    min-height: 44px;
    min-width: 44px;
}

/* =========================================================================
   ACCESSIBILITY: COLOR-BLIND SAFE BADGE VARIANTS (#P7-603)
   Use --fl-cb-* tokens. These rely on BOTH color AND shape/prefix glyphs
   so information is never conveyed by hue alone.
   ========================================================================= */
.badge-cb-positive {
    background-color: var(--fl-cb-positive-light);
    color: var(--fl-cb-positive);
    border-width: 1px;
    border-color: var(--fl-cb-positive-border);
}

.badge-cb-warning {
    background-color: var(--fl-cb-warning-light);
    color: var(--fl-cb-warning);
    border-width: 1px;
    border-color: var(--fl-cb-warning-border);
}

.badge-cb-critical {
    background-color: var(--fl-cb-critical-light);
    color: var(--fl-cb-critical);
    border-width: 1px;
    border-color: rgba(239, 68, 68, 0.45);
}

/* =========================================================================
   THUMB ERGONOMICS: BOTTOM ACTION BAR (#P7-604)
   Sticky container anchored at the bottom of the screen.
   Primary match/hub actions sit within the natural thumb reach zone
   (bottom 35% of 390×844 and 430×932 reference frames).
   ========================================================================= */
.bottom-action-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: var(--fl-bottom-action-bar-height);
    padding-left: var(--fl-bottom-action-bar-padding-h);
    padding-right: var(--fl-bottom-action-bar-padding-h);
    padding-bottom: var(--fl-safe-area-bottom);
    background-color: var(--fl-color-surface);
    border-top-width: 1px;
    border-top-color: var(--fl-color-border);
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
}

/* Single full-width primary CTA variant */
.bottom-action-bar--single {
    justify-content: center;
}

.bottom-action-bar--single .btn-ergonomic {
    flex-grow: 1;
    max-width: 480px;
}

/* Primary ergonomic CTA: tall enough for confident thumb taps */
.btn-ergonomic {
    min-height: 52px;
    border-radius: var(--fl-radius-lg);
    font-size: 15px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
    padding-left: 24px;
    padding-right: 24px;
    background-color: var(--fl-color-primary);
    color: #FFFFFF;
}

.btn-ergonomic:hover {
    background-color: var(--fl-color-primary-hover);
}

.btn-ergonomic:active {
    background-color: var(--fl-color-primary-active);
    scale: 0.97;
}

.btn-ergonomic--gold {
    background-color: var(--fl-color-gold);
    color: #0F172A;
}

.btn-ergonomic--gold:hover {
    background-color: var(--fl-color-gold-hover);
}

/* =========================================================================
   EMPTY / LOADING / ERROR STATES (#P7-602)
   Cohesive presentation shared across CareerHub, Transfers, Sponsorship,
   Lifestyle Shop, Trophies, and Cloud Save screens.
   ========================================================================= */

/* Container: centred column layout */
.empty-state {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 40px 32px;
    gap: 16px;
}

/* Large emoji/icon glyph */
.empty-state__icon {
    font-size: 48px;
    -unity-text-align: middle-center;
    color: var(--fl-color-text-muted);
}

/* Bold heading */
.empty-state__title {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--fl-color-text-primary);
    -unity-text-align: middle-center;
    white-space: normal;
}

/* Explanatory body copy */
.empty-state__body {
    font-size: 13px;
    color: var(--fl-color-text-secondary);
    -unity-text-align: middle-center;
    white-space: normal;
    max-width: 300px;
}

/* Primary CTA within the empty state */
.empty-state__action {
    margin-top: 8px;
    min-height: 44px;
    min-width: 160px;
}

/* Error / offline banner — docked at top of screen */
.error-banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    min-height: 52px;
    background-color: rgba(239, 68, 68, 0.92);
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    padding-right: 12px;
    gap: 10px;
}

.error-banner__icon {
    font-size: 18px;
    color: #FFFFFF;
}

.error-banner__text {
    flex-grow: 1;
    font-size: 13px;
    color: #FFFFFF;
    white-space: normal;
}

.error-banner__retry {
    min-height: 36px;
    min-width: 72px;
    background-color: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.4);
    border-width: 1px;
    border-radius: var(--fl-radius-md);
    color: #FFFFFF;
    font-size: 12px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
    padding-left: 10px;
    padding-right: 10px;
}

/* Goal framing banner — docked at bottom of tutorial overlay (#P7-601) */
.goal-banner {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    background-color: rgba(245, 158, 11, 0.12);
    border-width: 1px;
    border-color: rgba(245, 158, 11, 0.35);
    border-radius: var(--fl-radius-md);
    padding: 10px 14px;
    margin-top: 12px;
}

.goal-banner__icon {
    font-size: 18px;
}

.goal-banner__text {
    flex-grow: 1;
    font-size: 12px;
    color: var(--fl-color-text-gold);
    white-space: normal;
}

/* =========================================================================
   BADGE BLUE — used in tutorial step counter
   ========================================================================= */
.badge-blue {
    background-color: rgba(37, 99, 235, 0.2);
    color: #93C5FD;
    border-width: 1px;
    border-color: rgba(59, 130, 246, 0.5);
}

